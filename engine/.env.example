# Copy to .env for local use; never commit credentials or private URLs.
# ComfyUI must be running and reachable from this backend.
# Its workflow must be exported in API format and include a video output node.
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=./workflow_api.json
# Node id and input field to replace with the user's prompt.
COMFYUI_PROMPT_NODE_ID=6
COMFYUI_PROMPT_INPUT=text
# Optional absolute paths if binaries are not on PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
